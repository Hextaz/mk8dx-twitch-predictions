# Port et hôte (0.0.0.0 = accessible depuis le réseau local, ex: Touch Portal)
PORT=3003
HOST=0.0.0.0

# Emplacement de la base SQLite (optionnel, par défaut ./data)
# DATA_DIR=./data

# URL publique derrière un tunnel Cloudflare (optionnel).
# Laisser vide en local : la redirection OAuth utilisera http://localhost:3003.
# PUBLIC_URL=https://twitch.hextaz.dev

# Application Twitch (dev.twitch.tv/console, client "Confidentiel")
# Redirect URL à déclarer : http://localhost:3003/api/auth/twitch/callback
TWITCH_CLIENT_ID=votre_client_id_twitch
TWITCH_CLIENT_SECRET=votre_client_secret_twitch

# Login de ta chaîne principale. La connexion OAuth doit se faire avec CE compte :
# l'API Twitch refuse qu'un modérateur crée des prédictions.
TWITCH_BROADCASTER_NAME=Nolhan
